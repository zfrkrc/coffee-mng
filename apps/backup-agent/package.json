{
  "name": "@cafeos/backup-agent",
  "version": "0.1.0",
  "private": true,
  "description": "CafeOS Edge backup-agent — scheduled, compressed, encrypted Postgres backups",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
