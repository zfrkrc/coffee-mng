// CafeOS Edge — Prisma schema
//
// Database rules:
//  - UUIDv7 ids (sortable, global). Generated app-side (@cafeos/shared uuidv7)
//    so Edge works even if the DB version lacks uuidv7().
//  - Soft delete via deleted_at where appropriate; queries filter deletedAt.
//  - version column for optimistic concurrency.
//  - tenant isolation: every business table carries tenantId; branchId where
//    branch-scoped. Tenant/branch are ALWAYS resolved from the session, never
//    trusted from the client.
//
// PHASE 1 scope: foundation entities (tenant, branch, user, session, license,
// audit, settings). Domain tables (floor/table/menu/order/...) arrive in later
// phases — see docs/DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(dbgenerated())
  name      String
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  branches Branch[]
  users    User[]
  settings CafeSettings[]

  @@index([deletedAt])
  @@map("tenants")
}

model Branch {
  id        String    @id @default(dbgenerated())
  tenantId  String    @map("tenant_id")
  name      String
  code      String
  isActive  Boolean   @default(true)
  address   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(1)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  users    User[]
  settings CafeSettings[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("branches")
}

model User {
  id            String    @id @default(dbgenerated())
  tenantId      String    @map("tenant_id")
  branchId      String?   @map("branch_id")
  email         String
  username      String
  fullName      String?   @map("full_name")
  passwordHash  String    @map("password_hash")
  role          String    @default("viewer")
  isActive      Boolean   @default(true)
  mustChangePwd Boolean   @default(false) @map("must_change_pwd")
  failedLogins  Int       @default(0) @map("failed_logins")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  version       Int       @default(1)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  branch   Branch?       @relation(fields: [branchId], references: [id])
  sessions AuthSession[]
  audit    AuditLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId, branchId, deletedAt])
  @@map("users")
}

model AuthSession {
  id           String    @id @default(dbgenerated())
  userId       String    @map("user_id")
  refreshToken String    @unique @map("refresh_token")
  userAgent    String?
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model CafeSettings {
  id          String   @id @default(dbgenerated())
  tenantId    String   @map("tenant_id")
  branchId    String?  @map("branch_id")
  key         String
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, key])
  @@map("cafe_settings")
}

model License {
  id              String    @id @default(dbgenerated())
  tenantId        String    @map("tenant_id")
  branchId        String    @map("branch_id")
  deviceId        String    @map("device_id")
  plan            String    @default("standard")
  enabledFeatures Json
  issuedAt        DateTime  @map("issued_at")
  validUntil      DateTime  @map("valid_until")
  signature       String
  // Last successful signature verification (offline). Updated by node-agent.
  lastVerifiedAt  DateTime? @map("last_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, branchId, deviceId])
  @@map("licenses")
}

model AuditLog {
  id         String   @id @default(dbgenerated())
  tenantId   String   @map("tenant_id")
  branchId   String?  @map("branch_id")
  actorId    String?  @map("actor_id")
  actorEmail String?  @map("actor_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  remoteAddr String?  @map("remote_addr")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model AccessMember {
  id          String   @id
  email       String   @unique
  slug        String   @unique
  displayName String   @map("display_name")
  domain      String   @unique
  services    String[]
  active      Boolean  @default(true)
  token       String   @unique
  passwordHash String? @map("password_hash")
  telegramEnabled Boolean @default(false) @map("telegram_enabled")
  telegramBotToken String? @map("telegram_bot_token")
  telegramChatId String? @map("telegram_chat_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  staff AccessStaff[]
  branches AccessBranch[]

  @@map("access_members")
}

model AccessBranch {
  id              String   @id
  memberId        String   @map("member_id")
  slug            String
  name            String
  address         String?
  latitude        Float?
  longitude       Float?
  geofenceMeters  Int      @default(500) @map("geofence_meters")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  member AccessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, slug])
  @@index([memberId, active])
  @@map("access_branches")
}

model AccessStaff {
  id          String   @id
  memberId    String   @map("member_id")
  email       String
  displayName String   @map("display_name")
  role        String
  active      Boolean  @default(true)
  passwordHash String? @map("password_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  member AccessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, email])
  @@index([memberId])
  @@map("access_staff")
}

// ── POS DOMAIN — kalıcı hesap/sipariş takibi ("standart dükkan") ──
// memberId + branchSlug: AccessMember/AccessBranch kimliğiyle scopelar.
// Restarts'ta silinmez; gün vardiyasıyla açılır/kapanır.

// Domain-level menu items (per member+branch). Seed edilir; upsert/deletable.
model CafeMenuItem {
  id            String   @id
  memberId      String   @map("member_id")
  branchSlug    String?  @map("branch_slug")
  name          String
  category      String   @default("coffee")
  priceCents    Int      @map("price_cents")
  note          String   @default("")
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([memberId, branchSlug, id])
  @@index([memberId, branchSlug])
  @@map("cafe_menu_items")
}

// Domain-level tables (per member+branch). Seed edilir; upsert/deletable.
model CafeTable {
  id          String   @id
  memberId    String   @map("member_id")
  branchSlug  String?  @map("branch_slug")
  code        String
  name        String
  capacity    Int      @default(4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([memberId, branchSlug, code])
  @@index([memberId, branchSlug])
  @@map("cafe_tables")
}

model DayShift {
  id                 String    @id
  memberId           String    @map("member_id")
  branchSlug         String    @map("branch_slug")
  status             String    @default("open") // open | closed
  openedAt           DateTime  @default(now()) @map("opened_at")
  openedBy           String?   @map("opened_by")
  closedAt          DateTime?  @map("closed_at")
  closedBy          String?   @map("closed_by")
  openingFloatCents Int       @default(0) @map("opening_float_cents")
  expectedCents      Int?      @map("expected_cents")
  countedCents       Int?      @map("counted_cents")
  summary           Json?     // Z-rapor: {cashCents, cardCents, orderCount, accountCount, voidCents, ...}
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  accounts TableAccount[]
  orders   Order[]

  @@unique([memberId, branchSlug, openedAt])
  @@index([memberId, branchSlug, status])
  @@map("day_shifts")
}

model TableAccount {
  id            String    @id
  memberId      String    @map("member_id")
  branchSlug    String    @map("branch_slug")
  dayShiftId    String    @map("day_shift_id")
  tableCode     String    @map("table_code")
  tableName     String    @map("table_name")
  status        String    @default("open") // open | requested | paid | cancelled
  openedAt      DateTime  @default(now()) @map("opened_at")
  requestedAt   DateTime? @map("requested_at")
  closedAt      DateTime? @map("closed_at")
  paymentMethod String?   @map("payment_method") // cash | card
  totalCents    Int       @default(0) @map("total_cents")
  itemCount    Int       @default(0) @map("item_count")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  dayShift DayShift  @relation(fields: [dayShiftId], references: [id])
  orders   Order[]

  @@index([memberId, branchSlug, status])
  @@index([dayShiftId, status])
  @@index([tableCode, status])
  @@map("table_accounts")
}

model Order {
  id          String    @id
  memberId    String    @map("member_id")
  branchSlug  String    @map("branch_slug")
  dayShiftId  String    @map("day_shift_id")
  accountId   String?   @map("account_id")
  tableCode   String    @map("table_code")
  tableName   String    @map("table_name")
  status      String    @default("received") // received | preparing | ready | served | cancelled
  totalCents  Int       @default(0) @map("total_cents")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  dayShift DayShift      @relation(fields: [dayShiftId], references: [id])
  account  TableAccount? @relation(fields: [accountId], references: [id])
  items    OrderItem[]

  @@index([memberId, branchSlug, status])
  @@index([accountId])
  @@index([dayShiftId, status])
  @@map("orders")
}

model OrderItem {
  id              String   @id
  orderId         String   @map("order_id")
  menuItemId      String?  @map("menu_item_id")
  name            String
  quantity        Int      @default(1)
  unitPriceCents  Int      @map("unit_price_cents")
  lineTotalCents  Int      @map("line_total_cents")
  status          String   @default("ordered") // ordered | preparing | ready | served | voided | returned
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("order_items")
}

// ── Lead capture ("Ücretsiz Başla / Hemen Başla" formları) ──
model Lead {
  id        String   @id
  name      String
  email     String
  phone     String?
  site      String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("leads")
}
