# CafeOS Edge — environment template
#
# Copy to `.env.edge` (gitignored) and fill in real values.
# NEVER commit real secrets. Development defaults are safe for LAN-only.

# --- PostgreSQL ---
POSTGRES_USER=cafeos
POSTGRES_PASSWORD=cafeos
POSTGRES_DB=cafeos

# --- API ---
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=cafeos-edge
WEB_ORIGINS=http://localhost:3001,http://cafe.local
ENABLE_SWAGGER=true

# License verification public key (offline verification). Empty = disabled
# in development; production images MUST ship the Edge public key.
LICENSE_PUBLIC_KEY=
LICENSE_GRACE_SECONDS=604800

# --- Web ---
NEXT_PUBLIC_API_URL=http://cafe.local:3000

# --- Cloud (optional, never on the business path) ---
CLOUD_API_URL=
CLOUD_SYNC_ENABLED=false

# --- Backup agent ---
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
# Public key used to encrypt backups before upload (cloud holds private key).
BACKUP_ENCRYPTION_PUBLIC_KEY=

# --- Node agent ---
# Allowlist of remote actions permitted by cloud. Space separated.
REMOTE_ACTION_ALLOWLIST=health_check,collect_logs

# --- Compose ---
CAFEOS_VERSION=0.1.0
# Host port for the web container (default 3001).
WEB_PORT=3001
